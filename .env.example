# Copiez ce fichier en ".env" (à la racine du projet) et remplissez les valeurs réelles.
# Ne commitez jamais le fichier ".env" — seul ".env.example" doit être versionné.

# Token du bot Telegram, obtenu via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# Clé API pour le service de données football (ex: API-Football, Football-Data.org, etc.)
FOOTBALL_API_KEY=

# URL de base de l'API football utilisée (ex: https://v3.football.api-sports.io)
FOOTBALL_API_BASE_URL=
